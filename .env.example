# Pramanix AI Environment Configuration
# Copy this file to .env and configure your secrets: cp .env.example .env

# ==============================================================================
# AI Model Configuration (Required for AI responses)
# ==============================================================================
# Get your Google AI Studio API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Default model: gemini-2.5-flash (or gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# GitHub Integration (Optional - increases GitHub API rate limits from 60 to 5000/hr)
# ==============================================================================
# Create a personal access token at https://github.com/settings/tokens (no extra scopes needed)
GITHUB_TOKEN=

# ==============================================================================
# Server & Network Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins for development (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
